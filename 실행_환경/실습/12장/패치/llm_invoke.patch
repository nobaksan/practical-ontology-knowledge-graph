+def _extra_kwargs(name: str) -> dict:
+    """Extra request-body fields for ChatNVIDIA, read as JSON from env *name*.
+
+    Book-lab patch: the hosted endpoint rejects nvext.guided_json, so structured
+    output falls through to response_format, where a thinking model can spend the
+    whole max_tokens budget on reasoning and return empty content. This lets
+    .env pass e.g. {"chat_template_kwargs": {"enable_thinking": false}}.
+    """
+    import json as _json
+
+    raw = os.environ.get(name, "").strip()
+    return _json.loads(raw) if raw else {}
 
 
